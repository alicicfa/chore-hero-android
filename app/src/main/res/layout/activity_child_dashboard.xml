<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FBFB"
    android:padding="16dp">

    <!-- Header sa bodovima i odjavom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvChildPoints"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 PTS"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#2EC4B6" />

        <Button
            android:id="@+id/btnLogoutChild"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#E2E8F0"
            android:text="Odjavi se"
            android:textColor="#0F172A"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Moji zadaci"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#0F172A"
        android:layout_marginBottom="8dp" />

    <!-- Lista zadataka za dijete -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChildTasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

</LinearLayout>